# Copy to .env and fill in. NEVER commit .env (docs/NEVER_DO.md).

# Project phase. Phase 1 refuses to start against mainnet.
PHASE=1

# Cluster: devnet | mainnet-beta. A CONFIG switch, never a code fork (ADR-0004).
CLUSTER=devnet

# RPC: either a Helius key (URL derived per cluster) or an explicit RPC_URL.
HELIUS_API_KEY=your-helius-key
# RPC_URL=https://api.devnet.solana.com

# Path to the wallet keypair JSON (generated on first run if absent). Gitignored.
KEYPAIR_PATH=keypairs/devnet.json

# Data source: polling (real RPC reads) | synthetic (fixture snapshots for testing
# detection end-to-end). Both implement the same PriceSource interface (ADR-0006).
DATA_SOURCE=polling

# Trade size per attempt, in QUOTE token base units (USDC has 6 decimals,
# so 10000000 = 10 USDC).
TRADE_SIZE_QUOTE=10000000

# Minimum simulated net profit (quote base units) required to send.
# 10000 = 0.01 USDC. Never weakened to "make it work" (docs/NEVER_DO.md).
MIN_PROFIT_THRESHOLD_QUOTE=10000

# Slippage buffer applied to the whirlpool leg, basis points.
SLIPPAGE_TOLERANCE_BPS=50

# Client-side request ceiling. Helius free tier allows 10 req/s; stay below it.
MAX_RPS=8

# Delay between poll cycles (both pools are read once per cycle).
POLL_INTERVAL_MS=1000

# Estimated per-tx fee in quote base units, subtracted in detection.
# ADR-0007: LEAVE THIS UNSET for normal operation. When unset, the fee is
# derived at runtime from a real getFeeForMessage call (+20% headroom),
# converted to quote units at the live mid price each cycle. Set it ONLY to
# force a fixed manual override (testing/tuning) — it then bypasses the live
# fetch entirely and is used verbatim. It is NOT added on top of the
# computed default, and never touches MIN_PROFIT_THRESHOLD_QUOTE.
# EST_TX_FEE_QUOTE=1000

# ADR-0009: modeled Jito tip fraction of gross profit for NET-profit
# accounting in shadow mode. A MODEL ONLY — no tip is ever paid or sent.
# Owner-approved band: 0.50–0.60. Default 0.55.
# JITO_TIP_FRACTION=0.55

# Program IDs — defaults are cluster-appropriate; override only if they change.
# RAYDIUM_CPMM_PROGRAM_ID=
# ORCA_WHIRLPOOL_PROGRAM_ID=

# Pool + pair config (all required when DATA_SOURCE=polling). Devnet SOL/USDC.
RAYDIUM_POOL_ADDRESS=
ORCA_POOL_ADDRESS=
BASE_MINT=So11111111111111111111111111111111111111112
QUOTE_MINT=
BASE_DECIMALS=9
QUOTE_DECIMALS=6

# ---- Phase 2 (mainnet shadow mode) profile ----
# Run WITHOUT editing .env: pass these on the command line. Pool addresses
# and the USDC mint come from data/pools.mainnet.json (probe output) —
# never from memory. The send path is structurally disabled at PHASE=2
# (ADR-0008): loadConfig derives sendEnabled=false, the executor refuses,
# and the send transport throws.
# NOTE 2026-07-17: the Raydium venue is UNDECIDED — the deepest mainnet
# CPMM SOL/USDC pool failed the 100k-USDC depth gate (owner Decision 6
# pending). Do not start a shadow run until the owner picks the venue.
# VENUE selects the two arb venues: cpmm-orca (default, Raydium CPMM vs
# Orca) or orca-orca (two Orca whirlpools at different fee tiers — the
# Phase-2 interim venue, since mainnet Raydium CPMM SOL/USDC is too thin;
# see docs/phases/phase-2-mainnet-shadow-mode.md). orca-orca needs
# ORCA_POOL_ADDRESS + ORCA_POOL_ADDRESS_B (no Raydium pool).
# PHASE=2
# CLUSTER=mainnet-beta
# KEYPAIR_PATH=keypairs/mainnet-shadow.json   # fresh; NEVER funded, NEVER the devnet key
# DATA_SOURCE=polling
# VENUE=orca-orca
# ORCA_POOL_ADDRESS=Czfq3xZZDmsdGdUyrNLtRhGc47cXcZtLG4crryfu44zE      # 4bps, $32.5M TVL
# ORCA_POOL_ADDRESS_B=FpCMFDFGYotvufJ7HrFHsWEiiQCGbkLCtwHiDnh7o28Q    # 2bps, $579k TVL
# BASE_MINT=So11111111111111111111111111111111111111112
# QUOTE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# BASE_DECIMALS=9
# QUOTE_DECIMALS=6
# TRADE_SIZE_QUOTE=100000000        # 100 USDC notional for realistic impact
# MIN_PROFIT_THRESHOLD_QUOTE=10000  # 0.01 USDC
# SLIPPAGE_TOLERANCE_BPS=50
# MAX_RPS=8
# POLL_INTERVAL_MS=1500
# For cpmm-orca (default) instead of the two lines above:
# VENUE=cpmm-orca
# RAYDIUM_POOL_ADDRESS=<a deep-enough CPMM pool — see depth gate>
# ORCA_POOL_ADDRESS=<from data/pools.mainnet.json>
# SURROGATE_OWNER=<from scripts/find-surrogate.ts — funded wallet whose ATAs
#   shadow simulation borrows via sigVerify:false; read-only, nothing is sent>
# DATA_SOURCE=geyser needs an endpoint (NOT on the Helius free tier —
# owner decision pending; do not procure):
# GEYSER_ENDPOINT=
# GEYSER_X_TOKEN=

# --- VENUE=clmm-orca (Raydium CLMM vs Orca Whirlpool, cross-DEX shadow) ---
# VENUE=clmm-orca
# RAYDIUM_CLMM_POOL_ADDRESS=3ucNos4NbumPLZNWztqGHNFFgkHeRMBQAVemeeomsUxv  # live-verified SOL/USDC CLMM, $5.9M TVL, 4bps
# ORCA_POOL_ADDRESS=<a SOL/USDC Orca whirlpool>   # reused for the Orca leg
# RAYDIUM_CLMM_PROGRAM_ID=CAMMCzo5YL8w4VFF8KVHrK22GGUsp5VTaW7grrKgrWqK  # default; override only if needed
# (BASE_MINT/QUOTE_MINT/BASE_DECIMALS/QUOTE_DECIMALS as for the other venues)
