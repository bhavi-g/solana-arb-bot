{
  "name": "solana-arb-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Solana atomic arbitrage bot — Phase 1: devnet mechanics",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "pretest": "npm run build:rust",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:rust": "cargo build --release --manifest-path rust/arb-math/Cargo.toml"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "@triton-one/yellowstone-grpc": "5.0.9",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@orca-so/whirlpools-sdk": "0.21.0",
    "@raydium-io/raydium-sdk-v2": "0.2.59-alpha",
    "@solana/spl-token": "0.4.15",
    "@types/node": "22.10.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
